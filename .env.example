# Local environment template.
#
# Copy this file to .env.local and fill in the real values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit it. The values below are the ones
# the scripts and the API routes look for. See SECURITY-KEYS.md for where to
# get each key and where it also has to be set.

# Ankr API key. Used for archive RPC access to BSC.
#
# Needed by:
#   - scripts/buildAuditIndex.mjs   (the audit index)
#   - scripts/buildJoinDates.mjs    (the join date snapshot)
#   - src/app/api/kyc/pending-users/route.ts
#   - src/app/api/user/join-date/[wallet]/route.ts  (only as a faster path)
#
# Get one at https://ankr.com/app
ANKR_API_KEY=

# BscScan / Etherscan API key.
#
# Needed by:
#   - src/app/api/kyc/approved-users/route.ts
#   - src/lib/indexedUsers.ts
#
# Get one at https://etherscan.io/apis
BSCSCAN_API_KEY=

# Alternative to the Ankr key for archive RPC access. If set, it wins over
# ANKR_API_KEY. It has to be a node that serves old blocks.
BSC_RPC_URL=

# Key that encrypts the audit index. 64 hex characters, no prefix.
#
# It is deliberately NOT stored in .env.local. Keep it in the environment or
# in the gitignored .audit.key file beside the project root.
AUDIT_INDEX_KEY=

# The /audit page is unlocked by signing a message with a wallet listed here.
AUDIT_PAGE_ENABLED=0
AUDIT_SIGNERS=
