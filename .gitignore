# Local audit index. Never commit this: it contains every trade party address,
# every on-chain chat message and every payment screenshot CID. Regenerate with
# `npm run audit:build`.
p2p-audit.json
audit-srv.log
audit-srv.err

# The single-file offline build for phones. Same data as the index above, but
# self-contained, so it is even easier to email or upload by accident. Build with
# `npm run audit:offline`. The template is committed; only its output is ignored.
audit/gold4x-audit-offline.html

# The key that decrypts p2p-audit.enc. Deliberately kept out of .env.local, which
# is tracked in a public repository - that is how the Ankr and BscScan keys were
# exposed. This file is gitignored and must never be committed.
.audit.key
